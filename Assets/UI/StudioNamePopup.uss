.overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.popup-panel {
    width: 420px;
    padding: 24px;
    border-radius: 12px;
    background-color: rgb(32, 32, 36);
    border-width: 1px;
    border-color: rgb(60, 60, 66);
}

.title-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.subtitle-label {
    font-size: 12px;
    color: rgb(160, 160, 165);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
}

.name-field {
    margin-bottom: 4px;
}

.name-field > TextInput {
    font-size: 14px;
    padding: 6px;
    border-radius: 6px;
}

.validation-label {
    font-size: 11px;
    color: rgb(220, 90, 90);
    min-height: 16px;
    margin-bottom: 8px;
}

.button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}

.popup-button {
    min-width: 96px;
    padding: 6px 14px;
    border-radius: 6px;
    margin-left: 8px;
    -unity-font-style: bold;
}

.primary-button {
    background-color: rgb(66, 133, 244);
    color: white;
}

.primary-button:hover {
    background-color: rgb(85, 145, 250);
}

.primary-button:disabled {
    background-color: rgb(70, 70, 76);
    color: rgb(140, 140, 145);
}

.secondary-button {
    background-color: rgb(50, 50, 56);
    color: rgb(210, 210, 210);
}

.secondary-button:hover {
    background-color: rgb(64, 64, 70);
}
